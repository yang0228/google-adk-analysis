{
  "globs": [
    "*.md",
    "docs/**/*.md",
    "examples/**/*.md",
    ".github/**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    ".validation/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": ["details", "summary"]
    },
    "MD060": false
  }
}
